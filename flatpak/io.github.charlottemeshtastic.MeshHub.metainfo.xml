<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.charlottemeshtastic.MeshHub</id>
  <name>Mesh Hub</name>
  <summary>Meshtastic and MeshCore mesh network client</summary>
  <!-- metadata_license covers the AppStream metadata file itself, not the application -->
  <metadata_license>MIT</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      Mesh Hub is a desktop application for communicating with Meshtastic
      and MeshCore mesh networks via Bluetooth LE, USB serial, and MQTT.
      It supports diagnostics, channel management, node mapping, and direct
      messaging across both protocols simultaneously.
    </p>
  </description>
  <launchable type="desktop-id">io.github.charlottemeshtastic.MeshHub.desktop</launchable>
  <url type="homepage">https://github.com/charlottemeshtastic/mesh-client</url>
  <url type="bugtracker">https://github.com/charlottemeshtastic/mesh-client/issues</url>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.0.0" date="2026-10-11"/>
  </releases>
  <developer id="io.github.charlottemeshtastic">
    <name>Mesh Hub contributors</name>
  </developer>
</component>
